Private Sub myload()
Dim i As Double
Dim cString  As String, cStr2 As String
With grid1
'                           0               1                 2                3               4                5
    
    
    cString = " SELECT file6_20H.MAN , ' ' AS N2 ,   " & _
            " SUM(FILE6_20.QUANT) AS t_q, SUM(FILE6_20.TOTAL * ((100 - FILE6_20H.rate) / 100)) AS t_sales " & _
            " FROM FILE1_10 INNER JOIN FILE6_20 ON FILE1_10.ITEM = FILE6_20.ITEM INNER JOIN FILE6_20H ON FILE6_20.DOC_NO = FILE6_20H.DOC_NO LEFT OUTER JOIN FACT ON FILE1_10.FACT = FACT.CODE WHERE FILE1_10.MODELNO IS NOT NULL "
    If xMosm.BoundText <> "" Then cStr2 = cStr2 & " AND FILE1_10.MOSM = " & MyParn(xMosm.BoundText)
    If xSupp.BoundText <> "" Then cStr2 = cStr2 & " AND FILE1_10.CODE = " & MyParn(xSupp.BoundText)
    If xGroup.BoundText <> "" Then cStr2 = cStr2 & " AND FILE1_10.[GROUP] = " & MyParn(xGroup.BoundText)
    If xFact.BoundText <> "" Then cStr2 = cStr2 & " AND FILE1_10.FACT = " & MyParn(xFact.BoundText)
    If xStore.BoundText <> "" Then cStr2 = cStr2 & " AND FILE6_20h.store = " & MyParn(xStore.BoundText)
    If xSection.BoundText <> "" Then cStr2 = cStr2 & " AND FILE1_10.[Section] = " & xSection.BoundText
    If IsDate(xDate1.Text) Then cStr2 = cStr2 & " AND FILE6_20h.[DATE] >= " & DateSq(xDate1.Text)
    If IsDate(xdate2.Text) Then cStr2 = cStr2 & " AND FILE6_20h.[DATE] <= " & DateSq(xdate2.Text)

    cString = cString & cStr2 & " GROUP BY file6_20H.MAN ORDER BY file6_20H.MAN "
    DATA6.RecordSource = cString
    DATA6.Refresh
End With
FixGrid
If grid1.Rows > 0 Then grid1.TextMatrix(1, 1) = "«·≈Ã„«·Ï"
End Sub
Sub FixGrid()
With grid1
    .RowHeight(0) = 1000
    .RowHidden(1) = True
    .WordWrap = True
    
    .TextMatrix(0, 0) = "—ﬁ„ "
    .TextMatrix(0, 1) = "«·»«∆⁄ "
    
    .TextMatrix(0, 2) = "⁄œœ „»Ì⁄« "
    .TextMatrix(0, 3) = "ﬁÌ„… „»Ì⁄« "
    
    .ColWidth(0) = 1000
    .ColWidth(1) = 3000
    .ColWidth(2) = 2000
    .ColWidth(3) = 2000
    
    .ExplorerBar = flexExSort
    .Cell(flexcpAlignment, 0, 0, .Rows - 1, .Cols - 1) = 4
    
   
    
    For nRow = 1 To .Rows - 1
        .TextMatrix(nRow, 1) = GetDesca("select desca from file6_25 where code = " & MyParn(.TextMatrix(nRow, 0)))
    Next nRow
    
    For nCol = 2 To .Cols - 1
        .ColDataType(nCol) = flexDTDouble
        For nRow = 1 To .Rows - 1
            .TextMatrix(nRow, nCol) = Format(.TextMatrix(nRow, nCol), "#0.00")
        Next nRow
    Next nCol
    
    .SubtotalPosition = flexSTAbove
    For i = 2 To .Cols - 1
        .Subtotal flexSTSum, -1, i, "#0", vbRed, vbYellow, True, "  "
    Next i
    .Cell(flexcpAlignment, 1, 0, .Rows - 1, .Cols - 1) = 7
    End With
End Sub
