Private Sub myload()
Dim i As Double
Dim cStrall  As String

If IsDate(xDate1.Text) Then cWhere = " date <= " & DateSq(xDate1.Text)
i = 2


StoreTable.MoveFirst
Do Until StoreTable.EOF
    cWhere = " STORE = " & MyParn(StoreTable!CODE)
    cField2 = cField2 & turnFound(cField2, ",") & myiif(cWhere, "([IN] - [OUT]) * FILE1_10.COST ") & " AS " & addstring(StoreTable!CODE)
    StoreTable.MoveNext
Loop

With grid1
'                           0               1
    cStrall = " SELECT file0_60H.STORE , FILE0_40.desca " & _
                " SUM(FILE6_20.QUANT) AS t_q, SUM(FILE6_20.TOTAL * ((100 - FILE6_20H.rate) / 100)) AS t_sales, SUM(FILE6_20.QUANT * FILE6_20.cost) AS t_cost, SUM(FILE6_20.TOTAL * ((100 - FILE6_20H.rate) / 100) - FILE6_20.QUANT * FILE6_20.cost) AS t_proft " & _
            " FROM  FILE1_10 INNER JOIN FILE1_11 ON FILE1_10.ITEM = FILE1_11.ITEM INNER JOIN FACT ON FILE1_10.FACT = FACT.CODE LEFT OUTER JOIN Count_Model ON FILE1_10.MODELNO = Count_Model.MODELNO WHERE FILE1_10.MODELNO IS NOT NULL "
