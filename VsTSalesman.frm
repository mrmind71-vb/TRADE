        .TextMatrix(0, 2) = "«·›—⁄"
    Else
        .TextMatrix(0, 2) = "«·ﬁ”„"
    End If
    
    .TextMatrix(0, 3) = "⁄œœ „»Ì⁄« "
    .TextMatrix(0, 4) = "ﬁÌ„… „»Ì⁄« "
    
    .TextMatrix(0, 5) = "⁄œœ „— Ã⁄« "
    .TextMatrix(0, 6) = "ﬁÌ„… „— Õ⁄« "
    
    .TextMatrix(0, 7) = "’«›Ï ⁄œœ „»Ì⁄« "
    .TextMatrix(0, 8) = "’«›Ï ﬁÌ„… „»Ì⁄« "
    
    .TextMatrix(0, 9) = "‰”»… ﬁÌ„… «·„— Ã⁄« "
    
    
    .ColWidth(0) = 1000
    .ColWidth(1) = 3000
    .ColWidth(2) = 2000
    .ColWidth(3) = 1000
    .ColWidth(4) = 1400
    .ColWidth(5) = 1000
    .ColWidth(6) = 1400
    .ColWidth(7) = 1000
    .ColWidth(8) = 1200
    .ColWidth(9) = 1200
    
    .ExplorerBar = flexExSort
    
    For nCol = 3 To .Cols - 2
        .ColFormat(nCol) = "#0.00"
        .ColDataType(nCol) = flexDTDouble
        For nRow = 1 To .Rows - 1
            .TextMatrix(nRow, nCol) = Format(Val(.TextMatrix(nRow, nCol)), "#0.00")
        Next nRow
    Next nCol
    .SubtotalPosition = flexSTAbove
    For nCol = 3 To 8
        .Subtotal flexSTSum, -1, nCol, "#0.00", vbGreen, , True, "  "
        If Check1.Value <> 0 Then
            .Subtotal flexSTSum, 0, nCol, "#0.00", vbYellow, , True, "  "
        End If
    Next nCol
    For nRow = 1 To .Rows - 1
        If Val(.TextMatrix(nRow, 4)) <> 0 Then .TextMatrix(nRow, 9) = Round(Val(.TextMatrix(nRow, 6)) / Val(.TextMatrix(nRow, 4)) * 100, 2)
    Next nRow
    .Cell(flexcpAlignment, 0, 0, .Rows - 1, .Cols - 1) = 7
    For nCol = 3 To .Cols - 2
        .ColFormat(nCol) = "#,###,##0"
    Next nCol
    End With
End Sub
