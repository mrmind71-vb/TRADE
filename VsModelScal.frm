Sub myload()
    Dim cField1 As String
    Dim cWhere As String
    Dim ScalTable As New ADODB.Recordset
    
    If xMosm.BoundText <> "" Then cStr2 = cStr2 & " AND FILE1_10.MOSM = " & MyParn(xMosm.BoundText)
    
    If xModelFact.text <> "" Then cStr2 = cStr2 & " AND FILE1_10.MODELFACT0 = " & MyParn(xModelFact.text)
    If xbarcode.text <> "" Then
        xModelFact.text = GetDesca("SELECT MODELFACT WHERE ITEM = " & Val(xbarcode.text), con)
    End If
    If xSupp.BoundText <> "" Then cStr2 = cStr2 & " AND FILE1_10.CODE = " & MyParn(xSupp.BoundText)
    If xgroup.BoundText <> "" Then cStr2 = cStr2 & " AND FILE1_10.[GROUP] = " & MyParn(xgroup.BoundText)
    If xFact.BoundText <> "" Then cStr2 = cStr2 & " AND FILE1_10.FACT = " & MyParn(xFact.BoundText)
    If XSECTION.BoundText <> "" Then cStr2 = cStr2 & " AND FILE1_10.[section] = " & MyParn(XSECTION.BoundText)
    If Trim(xDesca.text) <> "" Then cString = cString & turn(cString) & MyParnAnd(xDesca.text, "file1_10.desca")

    cStr1 = " SELECT FILE1_10.SCAL, SCAL.SORT FROM         FILE1_10 LEFT OUTER JOIN SCAL ON FILE1_10.SCAL = SCAL.SCAL WHERE FILE1_10.MODEL IS NOT NULL "
    cStr1 = cStr1 & cStr2
    cStr1 = cStr1 & " GROUP BY FILE1_10.SCAL, SCAL.SORT ORDER BY SCAL.SORT "
    ScalTable.Open cStr1, con, adOpenStatic, adLockReadOnly, adCmdText
    
    If IsDate(xdate1.text) Then cStr2 = cStr2 & " AND FILE1_11.[DATE] <= " & DateSq(xdate1.text)
    With ScalTable
        Do While Not .EOF
            cWhere = " file1_10.SCAL = " & MyParn(ScalTable!scal)
            cField1 = cField1 & ", SUM( CASE WHEN FILE1_10.SCAL = " & MyParn(!scal) & " THEN ([IN]-[OUT]) ELSE 0 END  ) AS '" & !scal & "' "
            ScalTable.MoveNext
        Loop
    End With
    cString = " SELECT  FILE1_10.MODEL, FACT.DESCA, FILE1_10.MOSM, FILE1_10.MODELFACT, FILE1_10.desca , FILE1_10.COLOR, MIN(FILE1_10.PRICE) AS PRICE, MIN(FILE1_10.PRICE2) AS PRICE2  , SUM(FILE1_11.[IN] - FILE1_11.OUT) AS bal  " & _
            cField1 & _
            " FROM         FILE1_10 INNER JOIN FACT ON FILE1_10.FACT = FACT.CODE LEFT OUTER JOIN FILE1_11 ON FILE1_10.ITEM = FILE1_11.ITEM  WHERE FILE1_10.MODELNO IS NOT NULL "
    
    cString = cString & cStr2 & " GROUP BY FILE1_10.MODEL, FACT.DESCA, FILE1_10.MOSM, FILE1_10.MODELFACT, FILE1_10.desca, FILE1_10.COLOR   "

    data6.RecordSource = cString
    data6.Refresh
    Fixgrd
End Sub
