Dim con As New ADODB.Connection
Public cModelList As String
Private Sub Form_Load()
    openCon con
    cString = " select code , desca , MODEL from ModelSupp  where modelno = " & MyParn(cModelList)
    Set grid1.DataSource = data1
    data1.ConnectionString = strCon
    data1.RecordSource = cString
    data1.Refresh
    With grid1
        .Editable = flexEDNone
        .ColWidth(0) = 1000
        .ColWidth(1) = 4000
        .ColHidden(2) = True
    End With
End Sub
Private Sub grid1_dblClick()
    cMyModel = grid1.TextMatrix(grid1.Row, 2)
    Unload Me
End Sub
