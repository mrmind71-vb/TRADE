Private Sub myload()
Dim I As Double
Dim cString  As String, cStr2 As String
With grid1
'                           0               1                 2                3               4                5
    
    
    If Check1.Value <> 0 Then
        cString = " SELECT FILE4_10.CODE , FILE4_10.desca , file1_10.mosm ,   " & _
                " SUM(FR6_20.QUANT) AS t_q, SUM(FR6_20.TOTAL * ((100-FR6_20H.RATE )/100)) AS t_sales, SUM(FR6_20.QUANT * FR6_20.cost) AS t_cost, SUM((FR6_20.TOTAL * ((100-FR6_20H.RATE )/100)) - (FR6_20.QUANT * FR6_20.cost)) AS t_proft " & _
                " FROM FILE1_10 INNER JOIN FR6_20 ON FILE1_10.ITEM = FR6_20.ITEM INNER JOIN FR6_20H ON FR6_20.DOC_NO = FR6_20H.DOC_NO INNER JOIN FILE4_10 ON FILE1_10.CODE = FILE4_10.CODE WHERE FILE1_10.MODELNO IS NOT NULL "
    Else
        cString = " SELECT FILE4_10.CODE , FILE4_10.desca , ' ' as n1 ,   " & _
                " SUM(FR6_20.QUANT) AS t_q, SUM(FR6_20.TOTAL * ((100-FR6_20H.RATE )/100)) AS t_sales, SUM(FR6_20.QUANT * FR6_20.cost) AS t_cost, SUM((FR6_20.TOTAL * ((100-FR6_20H.RATE )/100)) - (FR6_20.QUANT * FR6_20.cost)) AS t_proft " & _
                " FROM FILE1_10 INNER JOIN FR6_20 ON FILE1_10.ITEM = FR6_20.ITEM INNER JOIN FR6_20H ON FR6_20.DOC_NO = FR6_20H.DOC_NO INNER JOIN FILE4_10 ON FILE1_10.CODE = FILE4_10.CODE WHERE FILE1_10.MODELNO IS NOT NULL "
    End If
    If xMosm.BoundText <> "" Then cStr2 = cStr2 & " AND FILE1_10.MOSM = " & MyParn(xMosm.BoundText)
    If xSupp.BoundText <> "" Then cStr2 = cStr2 & " AND FILE1_10.CODE = " & MyParn(xSupp.BoundText)
    If xGroup.BoundText <> "" Then cStr2 = cStr2 & " AND FILE1_10.[GROUP] = " & MyParn(xGroup.BoundText)
    If xFact.BoundText <> "" Then cStr2 = cStr2 & " AND FILE1_10.FACT = " & MyParn(xFact.BoundText)
    If xStore.BoundText <> "" Then cStr2 = cStr2 & " AND store = " & MyParn(xStore.BoundText)
    If IsDate(xDate1.text) Then cStr2 = cStr2 & " AND FR6_20h.[DATE] >= " & DateSq(xDate1.text)
    If IsDate(xDate2.text) Then cStr2 = cStr2 & " AND FR6_20h.[DATE] <= " & DateSq(xDate2.text)

    If Check1.Value <> 0 Then
        cString = cString & cStr2 & " GROUP BY FILE4_10.CODE , FILE4_10.desca , file1_10.mosm ORDER BY FILE4_10.CODE ,  file1_10.mosm "
    Else
        cString = cString & cStr2 & " GROUP BY FILE4_10.CODE , FILE4_10.desca ORDER BY FILE4_10.CODE "
    End If
    
    DATA6.RecordSource = cString
    DATA6.Refresh
End With
